generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String?  @unique
  email     String   @unique
  name      String
  avatar    String?
  role             String   @default("user") // "user" or "admin"
  provider         String   @default("clerk") // "clerk" or "email"
  verified         Boolean  @default(true)
  status           String   @default("active") // "active" or "restricted"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trips         Trip[]
  expenses      Expense[]
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  notifications Notification[]
  tripMembers   TripMember[]
  expenseSplits ExpenseSplit[]

  @@index([clerkId])
  @@index([email])
}

model Trip {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  origin              String
  destination         String
  startDate           DateTime
  endDate             DateTime
  travelers           Int      @default(1)
  budget              Decimal  @db.Decimal(12, 2)
  currency            String   @default("INR")
  travelStyle         String
  transportPreference String
  hotelCategory       String
  foodPreference      String
  status              String   @default("planned") // "draft", "planned", "ongoing", "completed"
  coverImage          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  days                TripDay[]
  expenses            Expense[]
  bookings            Booking[]
  members             TripMember[]
  aiRecommendations   AIRecommendation[]

  @@index([userId])
  @@index([status])
}

model TripDay {
  id        String   @id @default(uuid())
  tripId    String
  dayNumber Int
  date      DateTime
  
  activities Activity[]
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Activity {
  id            String   @id @default(uuid())
  tripDayId     String
  time          String?  // e.g., "09:00 AM"
  name          String
  location      String
  description   String?
  duration      Int?     // in minutes
  estimatedCost Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("INR")
  category      String   // e.g., "beach", "restaurant", "museum", "transport"
  imageUrl      String?
  lat           Float?
  lng           Float?
  rating        Float?   // 1.0 - 5.0 star rating
  isHiddenGem   Boolean  @default(false)
  localTip      String?  // insider travel tip
  bestTimeToVisit String? // e.g., "Early morning", "Sunset"
  orderIndex    Int      @default(0) // for drag and drop ordering
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tripDay       TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}

model Hotel {
  id            String   @id @default(uuid())
  name          String
  description   String
  location      String
  address       String
  lat           Float
  lng           Float
  rating        Float
  reviewCount   Int      @default(0)
  pricePerNight Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  starRating    Int
  amenities     Json     @default("[]") // Array of strings
  images        Json     @default("[]") // Array of URLs
  createdAt     DateTime @default(now())
}

model Restaurant {
  id            String   @id @default(uuid())
  name          String
  cuisine       Json     @default("[]") // Array of cuisine types
  description   String
  location      String
  address       String
  lat           Float
  lng           Float
  rating        Float
  reviewCount   Int      @default(0)
  priceRange    String   // $, $$, $$$, $$$$
  openingHours  String
  images        Json     @default("[]") // Array of URLs
  createdAt     DateTime @default(now())
}

model Attraction {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  location      String
  address       String
  lat           Float
  lng           Float
  rating        Float
  reviewCount   Int      @default(0)
  entryFee      Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  timings       String
  duration      String
  images        Json     @default("[]") // Array of URLs
  createdAt     DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  tripId      String
  userId      String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR")
  description String
  date        DateTime
  splitType   String   @default("equal") // "equal", "exact", "percentage", "none"
  createdAt   DateTime @default(now())

  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits      ExpenseSplit[]

  @@index([tripId])
  @@index([userId])
  @@index([tripId, userId])
}

model Transport {
  id            String   @id @default(uuid())
  provider      String   // e.g. "Emirates", "Uber", "Eurostar"
  type          String   // "flight", "train", "bus", "car", "taxi"
  departureTime DateTime
  arrivalTime   DateTime
  duration      String   // e.g. "5h 30m"
  origin        String
  destination   String
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  comfortLevel  String   // "economy", "business", "first", "luxury"
  images        Json     @default("[]") // Array of URLs
  createdAt     DateTime @default(now())
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  tripId        String?
  type          String   // "flight", "hotel", "activity"
  status        String   @default("pending") // "pending", "confirmed", "cancelled"
  totalAmount   Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  bookingRef    String?  // Reference from provider
  provider      String   // "amadeus", "demo"
  isDemo        Boolean  @default(true) // Flag to clearly indicate demo bookings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  payment       Payment?
  flightDetails FlightBooking?
  hotelDetails  HotelBooking?

  @@index([userId])
  @@index([tripId])
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  status        String   @default("pending") // "pending", "completed", "failed", "refunded"
  paymentMethod String?  // "card", "upi", "demo"
  transactionId String?
  isDemo        Boolean  @default(true) // Flag to clearly indicate demo payments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model FlightBooking {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  airline       String
  flightNumber  String
  pnr           String?
  class         String   // "economy", "business"
  passengers    Int      @default(1)

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model HotelBooking {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  hotelName     String
  location      String
  checkIn       DateTime
  checkOut      DateTime
  roomType      String
  guests        Int      @default(1)

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(uuid())
  userId        String
  targetId      String   // ID of the hotel, restaurant, or attraction
  targetType    String   // "hotel", "restaurant", "attraction"
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType]) // Prevent duplicate reviews
  @@index([targetId, targetType])
}

model Wishlist {
  id            String   @id @default(uuid())
  userId        String
  name          String
  createdAt     DateTime @default(now())
  
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites     Favorite[]

  @@index([userId])
}

model Favorite {
  id            String   @id @default(uuid())
  wishlistId    String
  targetId      String   // ID of the hotel, restaurant, attraction, etc.
  targetType    String   // "hotel", "restaurant", "attraction", "destination"
  name          String?  // Cached name for display
  image         String?  // Cached image URL
  createdAt     DateTime @default(now())

  wishlist      Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, targetId, targetType]) // Prevent duplicate favorites
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String   // "trip_invite", "booking_confirmed", "expense_update", "weather_alert", "system"
  title         String
  message       String
  read          Boolean  @default(false)
  metadata      Json?    // Optional extra data (tripId, bookingId, etc.)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model TripMember {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  role      String   @default("viewer") // "owner", "editor", "viewer"
  joinedAt  DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@index([tripId])
}

model ExpenseSplit {
  id          String   @id @default(uuid())
  expenseId   String
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("pending") // "pending", "settled"
  createdAt   DateTime @default(now())

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

model AiUsageLog {
  id          String   @id @default(uuid())
  userId      String?  // Track which user made the request
  requestType String?  // "parse_prompt", "generate_itinerary", "regenerate_day", "alternative", "chat"
  prompt      String
  latencyMs   Int
  tokens      Int      @default(0)
  status      String   @default("success") // "success" or "failed"
  modelUsed   String   @default("gemini-2.5-flash")
  isDemo      Boolean  @default(false) // Flag for mock/demo responses
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}

model AIRecommendation {
  id            String   @id @default(uuid())
  tripId        String?
  targetId      String?  // Could be an Activity ID to replace
  type          String   // "alternative_activity", "budget_optimization", "hotel", "restaurant"
  context       Json     @default("{}") // Context used to generate this
  suggestion    Json     @default("{}") // The suggestion data
  status        String   @default("pending") // "pending", "accepted", "rejected"
  createdAt     DateTime @default(now())
  
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
