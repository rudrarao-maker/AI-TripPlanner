PORT=5000
NODE_ENV=development

# Using SQLite for rapid development as per the plan defaults
DATABASE_URL="file:./dev.db"

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_for_development
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_for_development
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Mock AI / LLM API Key (Swap with real later)
AI_API_KEY=mock_key
