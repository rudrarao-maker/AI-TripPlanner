# ============================================================
# AI Trip Planner — Server Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

PORT=5000
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripcraft?schema=public"

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Gemini AI API Key (get from https://aistudio.google.com/apikey)
# Set to "mock_key" for demo mode with mock data
GEMINI_API_KEY=mock_key

# OpenWeatherMap API Key (free tier: https://openweathermap.org/api)
OPENWEATHER_API_KEY=mock_key

# Clerk Authentication Keys (get from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Google Places API Key (optional, for real place data)
GOOGLE_PLACES_API_KEY=mock_key
